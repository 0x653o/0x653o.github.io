---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import TocRail from '../../components/TocRail.astro';

export async function getStaticPaths() {
    const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
        (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    );
    return posts.map((post, i) => ({
        params: { slug: post.id },
        props: {
            post,
            newer: posts[i - 1] ?? null,
            older: posts[i + 1] ?? null,
        },
    }));
}

const base = import.meta.env.BASE_URL;
const { post, newer, older } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
const ogImage = post.data.cover
    ? (await getImage({ src: post.data.cover, width: 1200 })).src
    : undefined;
---

<Base
    title={`${post.data.title} — mu1aq`}
    description={post.data.description}
    ogImage={ogImage}
    ogType="article"
>
    <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
            <span>{fmt(post.data.date)}</span>
            <span>by {post.data.author}</span>
            <span>{remarkPluginFrontmatter.minutesRead} · {remarkPluginFrontmatter.words} words</span>
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        {post.data.cover && (
            <div class="cover">
                <Image src={post.data.cover} alt={post.data.title} width={1600} loading="eager" />
            </div>
        )}
    </header>

    <Toc headings={headings} />
    <TocRail headings={headings} />

    <div class="prose">
        <Content />
    </div>

    <nav class="post-nav">
        {older ? (
            <a href={`${base}/posts/${older.id}/`}>
                <span class="dir">&larr; OLDER</span>
                {older.data.title}
            </a>
        ) : <span />}
        {newer ? (
            <a class="next" href={`${base}/posts/${newer.id}/`}>
                <span class="dir">NEWER &rarr;</span>
                {newer.data.title}
            </a>
        ) : <span />}
    </nav>
</Base>
