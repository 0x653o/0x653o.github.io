<div class="tabs">
    <div class="tabs-nav" role="tablist"></div>
    <div class="tabs-body"><slot /></div>
</div>

<script>
    function initTabs() {
        document.querySelectorAll<HTMLElement>('.tabs:not([data-init])').forEach((tabs) => {
            tabs.dataset.init = '1';
            const nav = tabs.querySelector('.tabs-nav')!;
            const panels = [...tabs.querySelectorAll<HTMLElement>(':scope > .tabs-body > .tab-panel')];
            panels.forEach((panel, i) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.role = 'tab';
                btn.textContent = panel.dataset.label ?? `tab ${i + 1}`;
                btn.addEventListener('click', () => {
                    panels.forEach((p, j) => p.classList.toggle('active', j === i));
                    nav.querySelectorAll('button').forEach((b, j) =>
                        b.classList.toggle('active', j === i)
                    );
                });
                nav.appendChild(btn);
            });
            panels[0]?.classList.add('active');
            nav.querySelector('button')?.classList.add('active');
        });
    }
    initTabs();
    document.addEventListener('astro:page-load', initTabs);
</script>

<style>
    .tabs {
        margin: 1.6em 0;
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
    }
    .tabs-nav {
        display: flex;
        flex-wrap: wrap;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }
    .tabs-nav :global(button) {
        background: none;
        border: none;
        border-right: 1px solid var(--border);
        color: var(--fg-muted);
        font: inherit;
        font-size: 12px;
        letter-spacing: 0.08em;
        padding: 10px 18px;
        cursor: pointer;
        min-height: 40px;
    }
    .tabs-nav :global(button:hover) {
        color: var(--fg);
    }
    .tabs-nav :global(button.active) {
        color: var(--accent);
        background: var(--bg-elevated);
        box-shadow: inset 0 2px 0 var(--accent);
    }
    .tabs-body {
        padding: 16px 20px;
        background: var(--bg-elevated);
    }
    .tabs-body :global(.tab-panel) {
        display: none;
    }
    .tabs-body :global(.tab-panel.active) {
        display: block;
    }
</style>
