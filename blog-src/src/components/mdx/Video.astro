---
interface Props {
    src: string;
    title?: string;
    poster?: string;
}

const { src, title = 'video', poster } = Astro.props;
const yt = src.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([\w-]{6,})/);
---

{yt ? (
    <div class="video-embed">
        <iframe
            src={`https://www.youtube-nocookie.com/embed/${yt[1]}`}
            title={title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
        ></iframe>
    </div>
) : (
    <video class="video-local" controls preload="metadata" poster={poster}>
        <source src={src} />
        Your browser does not support the video tag.
    </video>
)}

<style>
    .video-embed {
        margin: 1.6em 0;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
    }
    .video-embed iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
    }
    .video-local {
        margin: 1.6em 0;
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 4px;
        display: block;
    }
</style>
